# Antibody configuration (spec §13). Copy to .env and `set -a; . ./.env; set +a`.
# Never commit .env or key files.

# live = Walrus Memory mainnet + Tatum; offline = fixture chain + local relayer (prints SIMULATED)
ANTIBODY_BACKEND=offline
ANTIBODY_HOME=~/.antibody
# enforce (live default) refuses to start if a role can read another role's key; simulated allows one OS user
# ANTIBODY_KEY_ISOLATION=enforce

# Walrus Memory
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_ACCOUNT_ID=
# Mainnet IDs, cross-checked against GET /config by the probe
MEMWAL_PACKAGE_ID=0xe7c16fbea0560e7057e2bf7422feaa4fb313749fc69c9e9092fac7a33b81d7f5
MEMWAL_REGISTRY_ID=0x8bf82c9e09e36b8d1c38298f68b7cb68e7b8762887e7592add9986d5e9cf199f
SUI_NETWORK=mainnet

# Tatum (mainnet key; the Storage API needs one)
TATUM_API_KEY=
# gRPC is the default chain transport (Sui deprecated public JSON-RPC on 2026-04-22)
ANTIBODY_CHAIN_TRANSPORT=grpc
TATUM_SUI_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io
# FR-19: a second, independent RPC that must agree on the account's delegate set (fail closed if not)
# ANTIBODY_CROSSCHECK_RPC_URL=https://fullnode.mainnet.sui.io:443
# ANTIBODY_CROSSCHECK_TRANSPORT=grpc

# Steward's wallet (written by `antibody setup`; the signer holds its key)
STEWARD_WALLET_ADDRESS=

# Steward's model. Unset = offline scripted model (SIMULATED). Check it with: antibody llm test
#  Fortytwo (decentralised inference, Qwen): set these two and nothing else
#    LLM_PROVIDER=fortytwo
#    LLM_API_KEY=            # from platform.fortytwo.network; give it a spend limit
#  Any other OpenAI-compatible endpoint:
#    LLM_BASE_URL=https://api.openai.com/v1
#    LLM_API_KEY=
#    LLM_MODEL=
LLM_PROVIDER=
LLM_API_KEY=
# Overrides (optional). With LLM_PROVIDER=fortytwo the defaults are
# https://api.fortytwo.network/v1, qwen/qwen3.8-27b and reasoning effort low.
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_REASONING_EFFORT=low       # none | minimal | low | medium | high | xhigh | max
# LLM_TIMEOUT_MS=120000

# Owner wallet: only for `antibody setup`, `antibody revoke` and the probe.
# A throwaway owner used for the demo; prefer a browser wallet for anything real.
OWNER_SUI_PRIVATE_KEY=

# Probe only: an existing delegate key from the memory.walrus.xyz dashboard (hex)
PROBE_DELEGATE_KEY=

# Tatum Data API base (USD display only)
# TATUM_API_URL=https://api.tatum.io
# FR-19 cross-check: key for the second RPC, if it needs one
# ANTIBODY_CROSSCHECK_API_KEY=

# ---- Roles and keys ----------------------------------------------------------
# Set by `antibody up` for each process; set it yourself only when running one role by hand
# ANTIBODY_ROLE=control            # control | steward | ingest | signer
# Encrypted key files (`antibody keys encrypt`). One shared passphrase, or one per
# role so no process can unlock another's key. Each has a _FILE variant that
# names a file holding the passphrase.
# ANTIBODY_KEY_PASSPHRASE=
# ANTIBODY_KEY_PASSPHRASE_FILE=
# ANTIBODY_KEY_PASSPHRASE_CONTROL=
# ANTIBODY_KEY_PASSPHRASE_STEWARD=
# ANTIBODY_KEY_PASSPHRASE_INGEST=
# ANTIBODY_KEY_PASSPHRASE_SIGNER=
# Skip the "is this you?" prompt before owner-wallet actions (scripts only)
# ANTIBODY_ASSUME_OWNER=1
# Another env file to read instead of ~/.antibody/antibody.env
# ANTIBODY_ENV_FILE=

# ---- Payments ----------------------------------------------------------------
# x402 is off unless at least one origin is allowed (comma separated, exact origins)
# ANTIBODY_X402_ALLOW=https://bills.example.com

# ---- Alerts (antibody alert test) ---------------------------------------------
# ANTIBODY_ALERT_WEBHOOK=https://hooks.example.com/antibody
# ANTIBODY_TELEGRAM_BOT_TOKEN=
# ANTIBODY_TELEGRAM_CHAT_ID=

# ---- Local console -------------------------------------------------------------
# ANTIBODY_WEB_PORT=7402
# Operator sign-in link secret (otherwise only the owner wallet can sign in)
# ANTIBODY_WEB_TOKEN=
# zkLogin proof checks go to this Sui RPC
# ANTIBODY_ZKLOGIN_RPC_URL=https://fullnode.mainnet.sui.io:443
# Do not open a browser on `antibody up` / `antibody open`
# ANTIBODY_NO_BROWSER=1

# ---- Logs -------------------------------------------------------------------------
# ANTIBODY_LOG=stderr              # also print the JSON log to stderr
# ANTIBODY_DEBUG=1                 # stack traces on errors

# ---- Tuning -------------------------------------------------------------------------
# ANTIBODY_SENTINEL_THRESHOLD=0.6
# ANTIBODY_AUTO_QUARANTINE_SCORE=0.6
# ANTIBODY_MAX_GAS_MIST=50000000

# ---- Hosted sandbox only (antibody cloud serve) ----------------------------------
# PORT=8080
# ANTIBODY_CLOUD_DATA=/data
# ANTIBODY_PUBLIC_ORIGIN=https://antibody-memory.netlify.app   # the site named in sign-in messages
# ANTIBODY_METRICS_TOKEN=          # /metrics answers 404 until this is set
# ANTIBODY_CLIENT_IP_HEADER=       # the proxy's real-client header, e.g. x-real-ip
# ANTIBODY_CLOUD_MAX_TENANTS=500
# ANTIBODY_CLOUD_MAX_OPEN=40
# ANTIBODY_CLOUD_NEW_PER_HOUR=200
# ANTIBODY_CLOUD_GLOBAL_RATE=1200
# ANTIBODY_CLOUD_RESETS_PER_HOUR=6
# ANTIBODY_CLOUD_IDLE_DAYS=14
