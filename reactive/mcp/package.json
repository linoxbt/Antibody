{
  "name": "antibody-guard-mcp",
  "version": "0.1.1",
  "description": "MCP server for Antibody Guard: let Claude, Cursor or any MCP client check addresses, recall guarded memory, score messages and act through a guarded vault.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "antibody-guard-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linoxbt/Antibody-gaurd.git",
    "directory": "mcp"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:zod --external:viem --banner:js='#!/usr/bin/env node'",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "viem": "^2.58.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "homepage": "https://antibody-guard-reactive.netlify.app/app/developers",
  "bugs": {
    "url": "https://github.com/linoxbt/Antibody-gaurd/issues"
  },
  "author": "linoxbt",
  "publishConfig": {
    "access": "public"
  }
}
