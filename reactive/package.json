{
  "name": "antibody-guard",
  "private": true,
  "type": "module",
  "description": "Antibody Guard: a guarded vault and a Reactive contract that protects an AI agent's spending across EVM chains.",
  "scripts": {
    "deps": "bash scripts/fetch-deps.sh",
    "build": "hardhat build",
    "test": "hardhat test",
    "deployer": "tsx scripts/deployer.ts",
    "web": "tsx scripts/build-web.ts",
    "phase1": "tsx scripts/phase1-base.ts",
    "evidence": "tsx scripts/evidence.ts",
    "verify": "tsx scripts/verify.ts",
    "faucet": "tsx scripts/faucet.ts",
    "phase2": "tsx scripts/phase2-loop.ts",
    "link-callbacks": "tsx scripts/link-callbacks.ts",
    "rmcp": "tsx scripts/rmcp.ts",
    "deposit": "tsx scripts/deposit.ts",
    "phase3": "tsx scripts/phase3.ts",
    "bridge": "tsx scripts/bridge.ts",
    "phase3-cross": "tsx scripts/phase3-cross.ts",
    "phase4": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 tsx scripts/phase4.ts",
    "typecheck": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2023 --allowImportingTsExtensions --types node --skipLibCheck --strict agent/*.ts scripts/*.ts networks.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "hardhat": "3.22.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "viem": "^2.58.1"
  }
}
