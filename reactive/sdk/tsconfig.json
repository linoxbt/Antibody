{
  "compilerOptions": {
    "target": "es2022", "module": "nodenext", "moduleResolution": "nodenext", "strict": true,
    "declaration": true, "outDir": "dist", "rootDir": "src", "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "rewriteRelativeImportExtensions": true, "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
