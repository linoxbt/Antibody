{
  "name": "antibody-guard-wallet",
  "private": true,
  "type": "module",
  "description": "The console's wallet connection (Reown AppKit), bundled into one browser file by esbuild.",
  "scripts": {
    "build": "esbuild wallet.ts --bundle --splitting --format=esm --minify --target=es2022 --outdir=dist --entry-names=wallet --chunk-names=w-[hash] --legal-comments=none --metafile=dist/meta.json --define:process.env.NODE_ENV='\"production\"' --define:global=globalThis"
  },
  "devDependencies": {
    "@reown/appkit": "^2.0.0",
    "@reown/appkit-adapter-wagmi": "^2.0.0",
    "@tanstack/query-core": "^5.108.1",
    "@wagmi/core": "^3.6.9",
    "esbuild": "^0.28.2",
    "viem": "^2.58.1",
    "wagmi": "^3.7.11"
  }
}
